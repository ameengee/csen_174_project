# Environment: local, test, prod
APP_ENV=local

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASS=postgres

# Logging Setup
JSON_LOGS=false
LOG_LEVEL=INFO

# Comma-separated origins allowed by CORS (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI API (profile analysis). Leave blank in committed files; set it locally.
OPENAI_API_KEY=
