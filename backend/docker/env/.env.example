# Environment: local, test, prod
APP_ENV=local

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASS=postgres

# No real email is sent; links are logged. Set false when hosted so sign-ups work.
REQUIRE_EMAIL_VERIFICATION=true
# Public URLs used in the logged verify/reset links
PUBLIC_API_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

# Logging Setup
JSON_LOGS=false
LOG_LEVEL=INFO

# Comma-separated origins allowed by CORS (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI API (profile analysis). Leave blank in committed files; set it locally.
OPENAI_API_KEY=

# Adzuna job search API (non-tech jobs). Free keys at developer.adzuna.com; leave blank to skip.
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Gemini API (AI Resume Tailor). Free key at aistudio.google.com
GEMINI_API_KEY=
